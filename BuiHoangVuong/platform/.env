# --- database (db service) ---
POSTGRES_USER=ews
POSTGRES_PASSWORD=ews
POSTGRES_DB=ews

# --- backend (be + worker) ---
# Assembled from the POSTGRES_* values above; override only to point at an external database.
DATABASE_URL=postgresql+psycopg://ews:ews@db:5432/ews
REDIS_URL=redis://redis:6379/0
AUTH_SECRET=dev-secret-change-me
TOKEN_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SEED_ON_START=true

# --- published ports ---
BE_PORT=8000
FE_PORT=8080

# --- tests ---
E2E_BASE_URL=http://localhost:8080
TEST_DATABASE_URL=postgresql+psycopg://ews:ews@localhost:5432/ews_test
